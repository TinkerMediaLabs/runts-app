+  @OptIn(UnstableApi::class)
+  override fun onSetMediaItems(
+    mediaSession: MediaSession,
+    controller: MediaSession.ControllerInfo,
+    mediaItems: MutableList<MediaItem>,
+    startIndex: Int,
+    startPositionMs: Long
+  ): ListenableFuture<MediaSession.MediaItemsWithStartPosition> {
+    val browseTree = BrowseTree.load(this)
+    val resolved = mediaItems.map { requested ->
+      if (requested.localConfiguration != null) return@map requested
+      browseTree.findItem(requested.mediaId)?.toMediaItem() ?: requested
+    }.toMutableList()
+
+    var index = startIndex
+    var position = startPositionMs
+    val target = if (startIndex == C.INDEX_UNSET) 0 else startIndex
+    if (position == C.TIME_UNSET && target in mediaItems.indices) {
+      val resume = browseTree.findItem(mediaItems[target].mediaId)?.startPositionSeconds
+      if (resume != null && resume > 0) {
+        position = (resume * 1000).toLong()
+        index = target
+      }
+    }
+    return Futures.immediateFuture(MediaSession.MediaItemsWithStartPosition(resolved, index, position))
+  }
