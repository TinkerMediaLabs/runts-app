{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "extends": [
    "plugin:react-native-a11y/basic"
  ],
  "plugins": [
    "react-native-a11y"
  ],
  "rules": {
    "react-native-a11y/has-accessibility-hint": "off",
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Property[key.name='fontSize'][value.type='Literal']",
        "message": "Use fontSizes from @/theme/tokens instead of a number."
      },
      {
        "selector": "Property[key.name='borderRadius'][value.type='Literal'][value.value>6]",
        "message": "Use radius from @/theme/tokens (circles may keep a number)."
      },
      {
        "selector": "Property[key.name=/[cC]olor$/][value.type='Literal'][value.value=/^#[0-9a-fA-F]{3,8}$/]",
        "message": "Use a color from @/theme/colors instead of a hex value."
      },
      {
        "selector": "JSXAttribute[name.name=/[cC]olor$/][value.type='Literal'][value.value=/^#[0-9a-fA-F]{3,8}$/]",
        "message": "Use a color from @/theme/colors instead of a hex value."
      }
    ]
  },
  "ignorePatterns": [
    "node_modules/",
    "amplify/",
    ".expo/"
  ],
  "overrides": [
    {
      "files": [
        "src/theme/**"
      ],
      "rules": {
        "no-restricted-syntax": "off"
      }
    }
  ]
}
